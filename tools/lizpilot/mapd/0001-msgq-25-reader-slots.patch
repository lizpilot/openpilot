diff --git a/settings/const.go b/settings/const.go
index b50c0d5..e46ab34 100644
--- a/settings/const.go
+++ b/settings/const.go
@@ -3,11 +3,27 @@ package settings
 import (
 	_ "embed"
 	"math"
+	"os"
+	"strconv"
 	"time"
 
 	"github.com/pfeiferj/gomsgq"
 )
 
+// MSGQ_MAX_READERS is the reader slots of openpilot's msgq queues (NUM_READERS in msgq/msgq.h). commaai/msgq d44b74a
+// (2026-09-06) raised it from 15 to 25. The queue header layout depends on it: with a different number on each side the
+// header is 240 bytes off and openpilot never reads a message of ours, nor we one of its.
+const MSGQ_MAX_READERS = 25
+
+// GetMaxReaders returns MSGQ_MAX_READERS, or the MSGQ_MAX_READERS environment variable when it holds a positive number
+// (15 for a msgq older than d44b74a).
+func GetMaxReaders() int64 {
+	if v, err := strconv.ParseInt(os.Getenv("MSGQ_MAX_READERS"), 10, 64); err == nil && v > 0 && v <= 1024 {
+		return v
+	}
+	return MSGQ_MAX_READERS
+}
+
 const (
 	// Queue sizes matching openpilot's services.py
 	QUEUE_SIZE_LEGACY    = 10 * 1024 * 1024 // 10MB - Used by all services in previous versions of msgq/openpilot
diff --git a/settings/const_test.go b/settings/const_test.go
new file mode 100644
index 0000000..d2e1cd7
--- /dev/null
+++ b/settings/const_test.go
@@ -0,0 +1,27 @@
+package settings
+
+import "testing"
+
+func TestGetMaxReaders(t *testing.T) {
+	cases := []struct {
+		env  string
+		want int64
+	}{
+		{"", MSGQ_MAX_READERS}, // openpilot's msgq since d44b74a: 25
+		{"15", 15},             // a msgq older than d44b74a
+		{"25", 25},
+		{"0", MSGQ_MAX_READERS},
+		{"-3", MSGQ_MAX_READERS},
+		{"abc", MSGQ_MAX_READERS},
+		{"5000", MSGQ_MAX_READERS},
+	}
+	for _, c := range cases {
+		t.Setenv("MSGQ_MAX_READERS", c.env)
+		if got := GetMaxReaders(); got != c.want {
+			t.Errorf("MSGQ_MAX_READERS=%q: got %d, want %d", c.env, got, c.want)
+		}
+	}
+	if MSGQ_MAX_READERS != 25 {
+		t.Errorf("MSGQ_MAX_READERS is %d: openpilot's msgq/msgq.h has NUM_READERS 25", MSGQ_MAX_READERS)
+	}
+}
